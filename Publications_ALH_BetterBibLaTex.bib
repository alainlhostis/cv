@article{boutsVisualEncodingDissimilarity2016,
  title = {Visual {{Encoding}} of {{Dissimilarity Data}} via {{Topology-Preserving Map Deformation}}},
  author = {Bouts, Q. W. and Dwyer, T. and Dykes, J. and Speckmann, B. and Goodwin, S. and Riche, N. H. and Carpendale, S. and Liebman, A.},
  date = {2016},
  journaltitle = {IEEE Transactions on Visualization and Computer Graphics},
  shortjournal = {IEEE Trans. Vis. Comput. Graph.},
  volume = {22},
  number = {9},
  pages = {2200--2213},
  issn = {1077-2626},
  doi = {10/f833kc},
  abstract = {We present an efficient technique for topology-preserving map deformation and apply it to the visualization of dissimilarity data in a geographic context. Map deformation techniques such as value-by-area cartograms are well studied. However, using deformation to highlight (dis)similarity between locations on a map in terms of their underlying data attributes is novel. We also identify an alternative way to represent dissimilarities on a map through the use of visual overlays. These overlays are complementary to deformation techniques and enable us to assess the quality of the deformation as well as to explore the design space of blending the two methods. Finally, we demonstrate how these techniques can be useful in several-quite different-applied contexts: travel-time visualization, social demographics research and understanding energy flowing in a wide-area power-grid.},
  keywords = {cartographic visualization,cartography,data attributes,data visualisation,Data visualization,deformation,demography,Dissimilarity,dissimilarity data visualization,geographic context,geographic information systems,Geography,maps,multidimensional scaling,Network topology,power grids,Roads,Shape,social demographics,social sciences computing,Stress,topology,Topology,topology-preserving map deformation,travel-time visualization,visual encoding,wide-area power-grid},
  file = {/home/alain/uLilleCloud/Travail/Bibliographie/Bouts et al_2016_Visual Encoding of Dissimilarity Data via Topology-Preserving Map Deformation.pdf;/home/lhostis/Zotero/storage/9K6ZQ6ZI/7328332.html}
}

