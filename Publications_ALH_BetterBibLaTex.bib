@article{hosford15minuteCityReach2022,
  title = {Is the 15-Minute City within Reach? {{Evaluating}} Walking and Cycling Accessibility to Grocery Stores in {{Vancouver}}},
  shorttitle = {Is the 15-Minute City within Reach?},
  author = {Hosford, Kate and Beairsto, Jeneva and Winters, Meghan},
  date = {2022-06-01},
  journaltitle = {Transportation Research Interdisciplinary Perspectives},
  shortjournal = {Transp. Res. Interdiscip. Perspect.},
  volume = {14},
  pages = {100602},
  issn = {2590-1982},
  doi = {10.1016/j.trip.2022.100602},
  url = {https://www.sciencedirect.com/science/article/pii/S2590198222000641},
  urldate = {2023-06-13},
  abstract = {Leaders around the world have embraced the idea of a “15-minute city”. This urban planning concept proposes a city where residents can meet their essential needs within a short walking or cycling trip from their home. Local access to grocery stores is a necessary component for cities to achieve the 15-minute city. This study aims to evaluate local accessibility to grocery stores by walking and cycling in the City of Vancouver. We used a cumulative opportunity measure to count the number of grocery stores available within a 15-minute walk and cycle from people’s homes. To evaluate accessibility from the perspective of younger and older travellers, we considered different travel speeds. Our results show there is good accessibility to grocery stores when cycling, with less than 1\% of the city’s population not having a grocery store within a 15-minute cycle. When assuming a walking speed of an older pedestrian, around one-fifth of the population did not have access to a grocery store in their local area. The neighbourhoods that did not have a store within a 15-minute walk had higher proportions of children, older adults, and visible minorities, and lower rates of employment and post-secondary education attainment. In seeking to improve accessibility via walking and cycling, cities should prioritize grocery store locations and investments in pedestrian and cycling infrastructure to underserved neighbourhoods and populations.},
  langid = {english},
  keywords = {15-minute city,Accessibility,Cycling,Food environments,Walking},
  note = {9 citations (Semantic Scholar/DOI) [2023-08-28]},
  file = {/home/lhostis/Zotero/storage/HF4SV3VD/Hosford et al. - 2022 - Is the 15-minute city within reach Evaluating wal.pdf;/home/lhostis/Zotero/storage/C2VJ33IS/S2590198222000641.html}
