@article{pradelRoutinesSpatialesFrontiere2010,
  title = {Les Routines Spatiales à La Frontière Du Travail},
  author = {Pradel, Benjamin and Chevallier, Leslie Belton},
  date = {2010},
  journaltitle = {Mobilités et modes de vie métropolitains, les intelligences du quotidien.},
  shortjournal = {Mobilités Modes Vie Métrop. Intell. Quotid.},
  pages = {279--292},
  url = {http://halshs.archives-ouvertes.fr/halshs-00547916},
  urldate = {2013-10-14},
  abstract = {A la modernité actuelle est associée une disparition des routines individuelles. Reflets de l'action traditionnelle, ces dernières cadrent mal avec l'idéal de fluidité et de mouvement permanent. Pour autant plusieurs contributions de cet ouvrage montrent qu'il ne faut pas conclure trop vite à la disparition des routines. Derrière l'idée de routines, se trouve celle d'habitudes, activités répétées et fortement intériorisées par les individus. Un des niveaux dans lequel elles s'inscrivent est celui même de la vie de tous les jours (C.Javeau, 2006). Ainsi les individus utilisent au quotidien ces routines en les construisant eux-mêmes de façon réflexive (F.Ascher, 2006). Leur existence est le témoignage d'une résistance et incite à relativiser les impacts supposés de la modernité actuelle. En effet, cette dernière s'inscrit résolument dans le présent et dans l'aléatoire symbole de liberté, refusant toute planification ou régularité. La valorisation du temps immédiat réfute l'idée de routine. Avec l'instauration d'un nouveau rapport au temps, la modernité actuelle semble également s'affranchir de l'idée d'espace. Les activités sociales seraient de moins en moins ancrées spatialement car de moins en moins routinières. Ainsi perte de sens du spatial et disparition des routines sont liées en vertu d'un culte moderne du temps immédiat. Au confluent de cette transformation de l'espace et du temps, se pose la question de la place du travail dans nos sociétés. Il se diluerait, serait moins attaché à un lieu délimité. Dans le contexte de la mondialisation, l'entreprise n'est plus un lieu unifié mais plutôt une multitude de lieux. L'éclatement du périmètre des entreprises renvoie à celui de leurs clients et leurs fournisseurs. Dans le but d'entretenir des relations avec ses partenaires, une firme a aussi recours à des employés de plus en plus mobiles. Ce regain de mobilité professionnelle physique se traduit par des lieux de travail de plus en plus variables et temporaires (G.Crague, 2004). Avec la distance, le cadre du travail serait moins apte à réguler les comportements des individus. Il le serait d'autant moins qu'il occupe une part décroissante dans la vie des individus. La diminution tendancielle du temps de travail libère les individus d'un temps contraint et routinier au profit des loisirs, du temps libre comme lieu de création autonome (G.Friedmann, cité par C.Javeau, ibid.). Enfin, la moindre capacité à réguler les actions des travailleurs se matérialise sur le lieu de travail. Les technologies de l'information et de la communication tel Internet permettent de s'en absoudre tout en étant physiquement présent (G.Cette, 2004). Faire ses courses, avoir des communications privées sont autant d'activités qui peuvent être effectuées au travail constituant une échappatoire « virtuelle ». Ces exemples font partie d'un ensemble d'évolutions socioéconomiques récentes qui renforcent la thèse d'un travail qui se dissout dans l'espace et dans le temps, qui ne serait plus en mesure de produire des routines même à sa proximité immédiate. Ces évolutions et leur impact sont à relativiser. L'objectif est ici de voir en quoi le travail structure le comportement des individus qui y séjournent par la production de routines à sa proximité temporelle mais surtout spatiale. L'intérêt est double. D'un point de vue sociologique, il s'agit de montrer la permanence d'éléments qui « contraignent » l'individu au travail sur le plan spatiotemporel malgré l'électivité et la liberté supposées de la modernité actuelle. D'un point de vue urbanistique, l'enjeu est de comprendre comment l'aménagement des environnements où s'insèrent les lieux du travail peut influer sur la structuration ou la déstructuration des routines spatiales associées au travail. A travers deux enquêtes distinctes, nous allons voir que l'environnement de travail reste un cadre d'actions, un lieu de routines spatiotemporelles. La première enquête a eu lieu dans le quartier d'affaires de La Défenses (92) en 2006. La seconde s'est déroulée sur les sites de l'opération Paris Plages en 2007. Ces deux enquêtes comportaient des objectifs différents. La première avait pour ambition de rendre compte des usages du site de La Défense alors que la seconde entendait mesurer les pratiques et perceptions de l'aménagement festif et éphémère dont bénéficient les berges de la Seine depuis 2002. Ces enquêtes se sont avérées complémentaires pour montrer la persistance de routines spatiales autours du travail par leur insertion dans un cadre de travail. En tant que quartier d'affaire, cette insertion est évidente pour La Défense. Moins évidente pour Paris Plages, elle existe également : les sites de la manifestation sont à proximité immédiate de nombreuse entreprises et donc de leurs salariés. La spécificité de Paris-Plages réside dans son caractère événementiel et récréatif. Ses concepteurs ont pour but de travailler la rupture avec le quotidien en faisant en sorte « et c'est l'intérêt de l'éphémère, que les gens croient en un espace et en très peu de temps » et en fournissant la possibilité de vivre « une échappée belle [...] une journée où l'emploi du temps n'est plus réglé à l'avance ». Nous allons voir que, malgré ce vœu pieux, Paris Plages (PP) rend compte de routines spatiales autours du travail tels qu'elles ont d'abord pu être observées à La Défense (LD).},
  keywords = {⛔ No DOI found,événement festif,Routine,rythmes,temporalités,travail},
  file = {/home/lhostis/Zotero/storage/65B7NZ59/halshs-00547916.html}
}

