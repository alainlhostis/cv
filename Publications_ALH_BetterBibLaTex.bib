@article{moarInconsistencySpatialKnowledge1983,
  title = {Inconsistency in Spatial Knowledge},
  author = {Moar, Ian and Bower, Gordon H.},
  date = {1983},
  journaltitle = {Memory \& Cognition},
  shortjournal = {Mem. Cognit.},
  volume = {11},
  number = {2},
  pages = {107--113},
  issn = {0090-502X, 1532-5946},
  doi = {10/bndg92},
  url = {http://link.springer.com/article/10.3758/BF03213464},
  urldate = {2013-04-18},
  abstract = {Two experiments examined whether spatial information judged from cognitive maps contains the functional euclidean properties of real maps. In Experiment 1, the six directions between sets of threetriad locations in a town were judged from memory. The angle formed by the two judged directions from a location to the other two locations in a triad was derived. The three derived angles of a triad were then summed. The derived angles were found to be biased toward 90 deg. The sum of the three derived angles of a triad also exceeded 180 deg, which violates the euclidean properties of real maps. In Experiment 2, subjects judged the direction between pairs of American cities in both directions. The judged directions were found to be consistently nonreversible, which is contrary to the properties of euclidean geometry. The study suggests that information judged from cognitive maps can contain internally inconsistent spatial properties, and the results are discussed in terms of current theories of spatial representation.},
  langid = {english},
  keywords = {Cognitive Psychology},
  note = {incohérences spatiales dans les représentations mentales, pas pour autant d'affirmation nette de violation de l'inégalité du triangle},
  file = {/home/lhostis/Zotero/storage/8D2KFM72/Moar et Bower - 1983 - Inconsistency in spatial knowledge.pdf;/home/lhostis/Zotero/storage/2FUI9ZN4/BF03213464.html}
}

