@article{millerPlaceBasedPeopleBasedGeographic2007,
  title = {Place-{{Based}} versus {{People-Based Geographic Information Science}}},
  author = {Miller, Harvey J.},
  date = {2007},
  journaltitle = {Geography Compass},
  shortjournal = {Geogr. Compass},
