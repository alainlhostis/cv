@article{boufQuelleMobiliteChine2008,
  title = {Quelle mobilité en Chine en 2050 ?},
  author = {Bouf, Dominique and Péguy, Pierre-Yves and Souche, Stéphanie and Routhier, Jean-Louis and Ovtracht, Nicolas and Kama, Alain Ayong Le},
  date = {2008},
  journaltitle = {Notes de synthèse du SESP},
  shortjournal = {Notes Synthèse SESP},
  pages = {pp. 25},
  url = {https://shs.hal.science/halshs-00322792},
  urldate = {2024-01-24},
  abstract = {En 2050, la Chine sera un pays développé, le PIB par habitant se situera entre celui du Japon et celui de la France de 2000. Quelle sera alors la mobilité des personnes et des marchandises ?{$<$}br /{$>$}D'après les simulations et des projections réalisées par le LET, et sous réserve des limites méthodologiques et de disponibilité des données statistiques, les quatre principales tendances sont les suivantes :{$<$}br /{$>$}•en interurbain, malgré de lourds investissements en infrastructures routières et une forte motorisation, les limites de capacité contraindront la mobilité des personnes ;{$<$}br /{$>$}•en urbain, même dans les scénarios les plus élevés, la mobilité d'une ville chinoise théorique se situerait en dessous des trois déplacements par jour et per capita. La part modale des transports collectifs atteindrait entre 25 \% et 30 \% ;{$<$}br /{$>$}•dans le domaine du transport aérien, il existera vraisemblablement un grand nombre de très grands aéroports, desservis par un chemin de fer suburbain et des trains rapides interurbains ;{$<$}br /{$>$}•pour poursuivre le développement de l'activité portuaire, la qualité de service ainsi que les infrastructures de transport pour les relations avec les zones d'approvisionnement et de desserte seront déterminantes.},
  issue = {N° spécial},
  langid = {french},
  keywords = {⛔ No DOI found},
  file = {/home/lhostis/Zotero/storage/BBXDGYY9/Bouf et al. - 2008 - Quelle mobilité en Chine en 2050 .pdf}
}

