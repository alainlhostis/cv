  abstract = {La desserte des espaces géographiques de densité moyenne ou faible par les transports collectifs est devenue une question incontournable de la planification territoriale. Pour les espaces périurbains, le projet de densifier à partir des gares est un leitmotiv des projets de développement territorial. Il est souvent mis en avant une spécificité des espaces périurbains français : leur faible densité. Dans ce cadre, cet article proposer de mesurer l’adhérence des territoires au réseau ferroviaire (et non l’inverse). Plus précisément, il s’agit d’analyser les dynamiques d’urbanisation, sur une période assez longue (quatre décennies), afin d’observer l’adhérence éventuelle entre les développements urbains et le réseau ferroviaire hérité.  Alors qu’aujourd’hui l’équation de mobilité a radicalement changé, notamment en raison de la banalisation de l’automobile et une distribution des droits à construire passée de l’Etat aux communes au début des années 1980, observe-t-on, par effet d’entraînement, la perpétuation d’un développement plus important dans les territoires que le rail pourrait desservir ? Autrement dit, quel est le degré d’adhérence par héritage ou, au contraire, d’indifférence spatiale de l’urbanisation par rapport au réseau ferroviaire ?},
  isbn = {978-2-85944-916-2},
  keywords = {TOD France},
  note = {sur 3 agglos Strasbourg, Rennes et Amiens},
  file = {/home/lhostis/Zotero/storage/GXV3TNU9/Desjardins - 2011 - Xavier DESJARDINS, Sylvain SEGURET, Francis BEAUCI.pdf}
}

