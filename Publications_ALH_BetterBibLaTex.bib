@article{liTransitOrientedDevelopment2019,
  title = {Transit Oriented Development among Metro Station Areas in {{Shanghai}}, {{China}}: {{Variations}}, Typology, Optimization and Implications for Land Use Planning},
  shorttitle = {Transit Oriented Development among Metro Station Areas in {{Shanghai}}, {{China}}},
  author = {Li, Zekun and Han, Zixuan and Xin, Jing and Luo, Xin and Su, Shiliang and Weng, Min},
  date = {2019-03-01},
  journaltitle = {Land Use Policy},
  volume = {82},
  pages = {269--282},
  issn = {0264-8377},
  doi = {10.1016/j.landusepol.2018.12.003},
  url = {https://www.sciencedirect.com/science/article/pii/S0264837718311931},
  urldate = {2025-12-02},
  abstract = {Transit Oriented Development (TOD), the integration of transport system with land use, has gained considerate priorities in planning strategies towards urban sustainability. To accrue a better overall leverage of the benefits arising from TOD practice, it is necessary to explore the variations and typology among TODs. This paper extends the classic ‘node (transport) – place (land use)’ model by incorporating the oriented characteristics that represent the morphological and functional ties between transport and land use. The model is applied to the case of Shanghai, China. Fuzzy AHP (Analytic Hierarchy Process) is used to construct the indicators system of each dimension (node, tie and place) in the model and typology among TODs is divided by SOM (self-organizing map). We find that the TOD index value declines from the urban center to the outskirts of the city obviously. Four typologies are identified among TODs, including the Integrated (all high node, tie and place index value), the Functionally place-developed (low node index value and high tie and place index value), the Morphologically node-developed (high node index value and low tie and place index value) and the Dispersed (all low node, tie and place index value). Based on the evaluation, we put forward an optimization plan for the areas with low TOD index values, which are consistent with the planned lines under construction. All the methods demonstrated in this study are easy to perform and can be widely applied to the assessment of TOD typologies worldwide. This study produces some generalized knowledge that are useful for implementing TOD practice within land use planning.},
  keywords = {Accessibility,Land use and transport integration,Land use planning,Node-place model,TOD},
  file = {/home/lhostis/Zotero/storage/487G8B42/S0264837718311931.html}
}

@unpublished{liuActivitySpaceReorganizationMetro2027,
  title = {Activity‑{{Space Reorganization}} of {{Metro Mobility Under Extreme Typhoon Weather Revealed}} by {{Weighted Spatial Statistics}} of {{Mobile Phone Signaling Data}}},
  author = {Liu, Dong and L'Hostis, Alain},
  date = {2027},
  abstract = {Extreme weather events can substantially disrupt urban mobility, yet their impacts extend beyond changes in metro ridership to the spatial reorganization of population activities around stations. This study investigates the effects of Typhoon Wipha on metro-related population mobility in Shenzhen using mobile phone signaling data. Three comparable four-day periods were selected to represent the reference, normal, and typhoon-affected conditions. Passenger flow ratios were used to quantify changes in travel demand, while population- and distance-weighted activity centers and Standard Deviational Ellipses (SDEs) were employed to characterize the temporal displacement and spatial extent of population activities within metro station service areas. K-means clustering was further applied to examine heterogeneous responses among different station types. Results show that metro-related travel activity declined substantially on July 20, accompanied by a marked contraction of SDEs, indicating a more spatially concentrated activity pattern. Meanwhile, cumulative activity-center displacement increased in many station service areas, revealing greater hour-to-hour spatial redistribution, with particularly pronounced changes in Pingshan District. Mobility patterns largely recovered on July 21. Three station types—low-intensity, employment-oriented, and residential-oriented—exhibited distinct activity patterns, while their relative spatial differences remained broadly stable during the typhoon. These findings reveal that typhoons affect not only travel demand but also the spatial extent and temporal stability of metro-related population activities, providing a more comprehensive basis for differentiated metro resilience planning and emergency management.},
  keywords = {DBSCAN,Non-Commute Activities,Public Transportation Big Data,Spatiotemporal Characteristics,Voronoi Diagram}
}

