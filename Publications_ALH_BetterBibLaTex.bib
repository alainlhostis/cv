  date = {2012},
  journaltitle = {Revue Géographique de l'Est},
  shortjournal = {Rev. Géographique Est},
  volume = {52},
  number = {1--2},
  issn = {035-3213},
  url = {http://rge.revues.org/3498},
  urldate = {2013-02-05},
  abstract = {Avec la réintroduction du tramway à Nantes en 1985 et le succès qu’il connaît depuis lors, plusieurs questions se posent sur les fonctionnalités du tramway. Quel est le rôle que les élus et les urbanistes font jouer au tramway~? Ce mode de transports collectifs a vu sa fonctionnalité première évoluée, elle est passée d’un instrument de ~déplacement à un outil de requalification urbanistique. Le tramway par rapport au métro et au bus à haut niveau de service (BHNS), assure par ses qualités propres une fonctionnalité de requalification urbanistique qui se rajoute à sa fonction première ou qui l’occulte totalement. Dans les choix effectués par certaines agglomérations, lorsque le tramway se trouve en concurrence avec le BHNS, en particulier lorsqu’il sort du cœur de la ville, il s’inscrit dans les politiques de mobilité globale.},
  langid = {french},
  keywords = {⛔ No DOI found,déplacement,pouvoirs publics,territoires,tramway,urbanisme},
  file = {/home/lhostis/Zotero/storage/6NZHV4AS/Wolff - 2012 - Le tramway  au cœur des enjeux de gouvernance ent.pdf;/home/lhostis/Zotero/storage/TGTEHF8Z/Wolff - 2012 - Le tramway  au cœur des enjeux de gouvernance ent.pdf;/home/lhostis/Zotero/storage/Q7C73DX7/3498.html;/home/lhostis/Zotero/storage/RNEPSSWK/3498.html}
