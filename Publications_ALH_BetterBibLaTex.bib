}

@article{hachedMobiliteDouceDisparites2020,
  title = {Mobilité Douce et Disparités Socio-Spatiales : Évaluation de l'ergonomie d'accès Aux Ressources Du Quotidien},
  shorttitle = {Mobilité Douce et Disparités Socio-Spatiales},
  author = {Hached, Wassim and Propeck-Zimmermann, Eliane},
  date = {2020-11},
  journaltitle = {Territoire en mouvement. Revue de Géographie et d'Aménagement},
  shortjournal = {Territ. En Mouv. Rev. Géographie Aménage.},
  number = {47},
  publisher = {Université de Lille},
  doi = {10.4000/tem.6717},
  url = {https://hal.science/hal-03448524},
  urldate = {2023-12-08},
  abstract = {In most large cities, public policies have led to reducing the prevalence of cars in different urban spaces, developing pedestrian and bicycle facilities or renewing public transport. This raises the question of the conditions of access to everyday resources throughout the urban agglomeration Are the arrangements for sustainable mobility, particularly soft modes (walking, cycling), configured to meet the needs of the population? Globally or selectively? Do soft modes offer a credible alternative to the car to take advantage of daily life resources? For everybody and where they are? To answer these questions, an analysis approach based on the concept of spatial ergonomics has been developed and implemented in a Geographic Information System. It takes into account, on the one hand, the availability and distribution of the potential of non-work resources (businesses, education, health, public services and leisure) and, on the other hand, a panel of criteria characterizing their access conditions (service, security, comfort, monetary cost). Although it is a first application of the principles of spatial ergonomics, the synthetic indicator, decomposed into its various components, and put in perspective with the socio-urban environments, has made it possible to reveal polarizing situations within the Strasbourg Eurométropole. The research is developed as part of an ANR RED project.},
  keywords = {acc\`es aux ressources,accès aux ressources,access to resources,daily resources,disparit\'es socio-spatiales,disparités socio-spatiales,ergonomie spatiale,mobilit\'e durable,mobilité durable,ressources quotidiennes,socio-spatial disparities,spatial ergonomics,sustainable mobility},
  note = {0 citations (Semantic Scholar/DOI) [2023-12-08]
\par
1 citations (Semantic Scholar/DOI) [2023-12-19]},
  file = {/home/lhostis/Zotero/storage/4S8LRDXD/Hached et Propeck-Zimmermann - 2020 - Mobilité douce et disparités socio-spatiales  éva.pdf;/home/lhostis/Zotero/storage/JICRG6U3/hal-03448524.html}
}

