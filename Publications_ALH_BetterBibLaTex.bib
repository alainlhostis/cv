@article{ewingLandUseImpacts1996,
  title = {Land {{Use Impacts}} on {{Trip Generation Rates}}},
  author = {Ewing, Reid and Deanna, Marybeth and Li, Shi-Chiang},
  date = {1996-01-01},
  journaltitle = {Transportation Research Record},
  shortjournal = {Transp. Res. Rec.},
  volume = {1518},
  number = {1},
  pages = {1--6},
  publisher = {SAGE Publications Inc},
  issn = {0361-1981},
  doi = {10.1177/0361198196151800101},
  url = {https://doi.org/10.1177/0361198196151800101},
  urldate = {2025-09-15},
  abstract = {In the conventional four-step travel demand modeling process, the number of trips made by a household is modeled in terms of household size, income, and other sociodemographic variables; any effect of location, land use, or transportation service level is discounted. This is the same as discounting any effect of household accessibility to out-of-home activities as a factor in trip generation (accessibility depending on all three: location, land use, and transportation service level). In contrast to the practice of trip generation, theory tells us that trip rates must vary with accessibility, and some (not all) empirical studies have found that they do. In light of conflicting empirical studies, and the obvious need for more precise and policy-sensitive travel forecasts, this issue is revisited. The independent effects of land use and accessibility variables on household trip rates were tested for using data from Florida travel surveys. It was found that, after controlling for sociodemographic variables, residential density, mixed use, and accessibility do not have significant, independent effects on household trip rates. Conventional trip generation models, which generate person trips by vehicle (not by all modes) and do so without regard to residential location, may not be as bad as one would imagine a priori.},
  langid = {english},
  note = {135 citations (Semantic Scholar/DOI) [2025-09-15]},
  file = {/home/lhostis/Zotero/storage/X8TS3EZ5/Ewing et al. - 1996 - Land Use Impacts on Trip Generation Rates.pdf}
}

@article{ewingMeasuringUnmeasurableUrban2009,
  title = {Measuring the {{Unmeasurable}}: {{Urban Design Qualities Related}} to {{Walkability}}},
