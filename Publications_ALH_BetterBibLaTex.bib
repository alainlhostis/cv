@article{hachedAccesAuxRessources2020,
  title = {Accès Aux Ressources Du Quotidien En Modes Doux à {{L}}'eurométropole de {{Strasbourg}} : {{Une}} Approche Basée Sur Le Concept d'ergonomie Spatiale},
