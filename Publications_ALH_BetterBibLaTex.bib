@misc{faivredarcierAmeliorationSituationFinanciere2009,
  title = {L'amélioration de La Situation Financière Des Transports Publics Urbains Est-Elle Possible ?},
  author = {Faivre D'Arcier, Bruno},
  date = {2009},
  url = {http://halshs.archives-ouvertes.fr/halshs-00455783/fr/},
  urldate = {2010-02-22},
  note = {Malgré les efforts de développement de l'offre, la situation financière de réseaux de transports publics s'est dégradée au cours de la période 1995-2005. Des projections sur la base des tendances observées montrent qu'en 2015 le coût public (investissement + déficit d'exploitation) pourrait augmenter de 61 à 76 \% selon la taille de réseaux. Quelques scenarios de politiques alternatives sont ensuite testées et montrent la nécessité de reformes profondes pour tenter de maîtriser une dérive de plus en plus problématique des contributions publiques, surtout dans le contexte financier actuel. Ils conduisent à s'interroger sur la performance des réseaux et leur capacité à attirer une nouvelle clientèle d'automobilistes dans la perspective d'une mobilité durable, condition indispensable pour justifier la recherche de nouveaux contributeurs au financement des transports publics urbains.}
}

