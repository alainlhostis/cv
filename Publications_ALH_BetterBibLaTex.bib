@article{orfeuilQuellesInteractionsEntre2002,
  title = {Quelles Interactions Entre Les Marchés de La Mobilité à Courte et à Longue Distance~?},
  author = {Orfeuil, Jean-Pierre and Soleyret, Danièle},
  date = {2002-10-01},
  journaltitle = {Recherche - Transports - Sécurité},
  shortjournal = {Rech. - Transp. - Sécurité},
  volume = {76},
  pages = {208--221},
  issn = {0761-8980},
  doi = {10/bpk9qw},
  url = {http://www.sciencedirect.com/science/article/pii/S0761898002000134},
  urldate = {2017-12-13},
  abstract = {Résumé Cet article propose une approche quantitative globale de la mobilité, intégrant les pratiques des personnes sur trois segments~: la mobilité locale de semaine, la mobilité locale de fin de semaine et la mobilité à longue distance. Une première partie évalue globalement ces différents marchés et montre le poids croissant de la mobilité à longue distance. L’analyse de chacun de ces marchés, puis de la mobilité globale est conduite ensuite suivant la position dans le cycle de vie, la localisation résidentielle et le niveau de revenu. Enfin, les rôles respectifs de la localisation et du revenu dans la formation de la demande sur les différents marchés sont étudiés dans la partie centrale du cycle de vie. On montre notamment l’absence de compensation entre la mobilité de semaine et la mobilité de fin de semaine, mais on note des interactions non négligeables entre la mobilité locale et la mobilité à longue distance, notamment avec la localisation résidentielle. Abstract This paper proposes a comprehensive quantitative approach to travel analysis that considers personal travel practices with regard to three travel market segments: local weekday travel, local weekend travel and long-distance travel. The first section consists of an evaluation of the overall size of these segments and demonstrates the increasing importance of long-distance travel. Each market segment and then travel as a whole are then analyzed according to individuals’ position in the life cycle, residential location and income level. Last, the roles of location and income in the creation of travel demand in the different segments are then investigated for individuals in the middle part of the life cycle. In particular, it is demonstrated that weekend and weekday travel do not compensate for one another, but there are significant interactions between both local and long-distance travel, and, in particular, residential location.},
  issue = {Supplement C},
  keywords = {Local travel,Long-distance travel,Mobilité à longue distance,Mobilité globale,Mobilité locale,Passenger transport,Total travel,Transport de voyageurs},
  file = {/home/lhostis/Zotero/storage/2TC6MY8Q/Orfeuil et Soleyret - 2002 - Quelles interactions entre les marchés de la mobil.pdf;/home/lhostis/Zotero/storage/64I38WYI/S0761898002000134.html}
}

