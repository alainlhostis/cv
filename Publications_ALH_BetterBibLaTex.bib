@article{schiefelbuschRationalPlanningEmotional2010,
  title = {Rational Planning for Emotional Mobility? {{The}} Case of Public Transport Development},
  shorttitle = {Rational Planning for Emotional Mobility?},
  author = {Schiefelbusch, Martin},
  date = {2010-01-08},
  journaltitle = {Planning Theory},
  shortjournal = {Plan. Theory},
  volume = {9},
  number = {3},
  pages = {200--222},
  issn = {1473-0952, 1741-3052},
  doi = {10/ggw59g},
  url = {http://plt.sagepub.com/content/9/3/200},
  urldate = {2015-06-11},
  abstract = {Transport studies and planning have traditionally considered mobility as a rational activity, necessitated by external factors and shaped by economic considerations. This has led to a focus on quantitative criteria as explanatory factors and left other aspects such as the travellers’ perception of mobility and the links between mobility and other parts of life largely unexplored. But studies from cultural and social sciences show that mobility has wider implications, for instance, by serving psychological and social needs. The article undertakes a critical review of the evolution of transport planning, outlines the main elements of the discipline’s worldview and explores the reasons for its difficulties in handling the ‘soft’ dimensions of mobility such as comfort, ambience, sensual stimulation. It becomes clear that these difficulties can be traced back to the profession’s origins in infrastructure design and economic assessment. The article considers the main criticisms of the traditional mindset and, focusing on travel as an activity, outlines some possibilities to make ‘soft’ aspects more accessible from a planning perspective.},
  langid = {english},
  keywords = {derived demand,emotions,intrinsic mobility,rationality,transport economy,travel behaviour},
  file = {/home/lhostis/Zotero/storage/PKT7M5AT/Schiefelbusch - 2010 - Rational planning for emotional mobility The case.pdf;/home/lhostis/Zotero/storage/F2P99AT5/200.html}
