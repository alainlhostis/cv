  author = {Mark, David M. and Freksa, Christian and Hirtle, Stephen C. and Lloyd, Robert and Tversky, Barbara},
  date = {1999-12-01},
  journaltitle = {International Journal of Geographical Information Science},
  shortjournal = {Int. J. Geogr. Inf. Sci.},
