@incollection{lavandierInnovativeWaysAssess2022,
  title = {Towards {{Innovative Ways}} to {{Assess Annoyance}}},
  booktitle = {Aviation {{Noise Impact Management}}: {{Technologies}}, {{Regulations}}, and {{Societal Well}}-Being in {{Europe}}},
  author = {Lavandier, Catherine and Aalmoes, Roalt and Dedieu, Romain and Marki, Ferenc and Großarth, Stephan and Schreckenberg, Dirk and Gharbi, Asma and Kotzinos, Dimitris},
