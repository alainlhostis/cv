@inproceedings{goreckiDevelopmentTransportModel2022,
  title = {Development of a {{Transport Model Dedicated}} to an {{Agent-Based Simulation}} of {{Land Use}}},
  booktitle = {Agents and {{Multi-Agent Systems}}: {{Technologies}} and {{Applications}} 2022},
  author = {Gorecki, Simon and Zerguini, Seghir and Gaussier, Nathalie and Traore, Mamadou Kaba},
  editor = {Jezic, Gordan and Chen-Burger, Yun-Heh Jessica and Kusek, Mario and Šperka, Roman and Howlett, Robert J. and Jain, Lakhmi C.},
  date = {2022},
  series = {Smart {{Innovation}}, {{Systems}} and {{Technologies}}},
  pages = {301--311},
  publisher = {Springer Nature},
  location = {Singapore},
  doi = {10.1007/978-981-19-3359-2_26},
  abstract = {In order to limit greenhouse gas emissions, urban travel is a central point of interest for metropolises as part of their actions in favor of ecological transition. MUST-B is a land use transport interaction (LUTI) model that simulates the location choices of households and jobs. It models and simulates the interaction both of the population of an agglomeration through its residential choices with activities and jobs, but also the different modes of transport to satisfy daily mobility. This tool based on the agent-based paradigm makes it possible to apprehend the complexity of an urban territory from individual behaviors giving rise to collective phenomena. In this article, we concentrate on the “transport” part of the tool, show how the elaboration and the calibration of this model are done, and study an example of its reaction to a variation of setpoints.},
  isbn = {978-981-19-3359-2},
  langid = {english}
}

