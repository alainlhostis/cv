@article{vanderwaerdenExtentNatureCovariates2009,
  title = {Extent, {{Nature}}, and {{Covariates}} of {{Multitasking}} of {{Rail Passengers}} in an {{Urban Corridor}}},
  author = {family=Waerden, given=Peter, prefix=van der, useprefix=true and Timmermans, Harry and family=Neerven, given=Rob, prefix=van, useprefix=true},
  date = {2009-12-01},
  journaltitle = {Transportation Research Record: Journal of the Transportation Research Board},
  shortjournal = {Transp. Res. Rec. J. Transp. Res. Board},
  volume = {2110},
  pages = {106--111},
  doi = {10/brp8b2},
  url = {http://dx.doi.org/10.3141/2110-13},
  urldate = {2009-12-21},
  abstract = {A study of the frequency and nature of multitasking on Dutch trains is described. Descriptive and model analyses were carried out on the basis of field observations on intercity and regional trains. The most frequent task was "doing nothing," followed by "talking socially" and "reading a newspaper." On average, most time was spent in "study," followed by "reading a book," and "puzzles." A multinomial logistic regression model that describes the relationship between the probability of conducting a particular task and several personal and travel context variables is estimated. The most important variables that influence probability of the distinguished tasks are the presence of accompanying persons, age of traveler, travel day, type of train, crowdedness of train, and time of day. This type of information is useful for train companies to improve service quality and design marketing efforts and pricing regimes.},
  issue = {-1},
  keywords = {age of traveler,crowdedness of train,type of train},
  file = {/home/lhostis/Zotero/storage/ZNIWIDV5/van der Waerden et al. - 2009 - Extent, Nature, and Covariates of Multitasking of .pdf;/home/lhostis/Zotero/storage/W3PMNNQB/2110-13.html}
}

