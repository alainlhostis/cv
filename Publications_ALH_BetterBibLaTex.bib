@article{tropeConstrualLevelTheoryPsychological2010,
  title = {Construal-{{Level Theory}} of {{Psychological Distance}}},
  author = {Trope, Yaacov and Liberman, Nira},
  date = {2010-04},
  journaltitle = {Psychological review},
  shortjournal = {Psychol. Rev.},
  volume = {117},
