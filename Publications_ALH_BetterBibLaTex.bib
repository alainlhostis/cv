@article{canFutureUrbanSound2020,
  title = {The Future of Urban Sound Environments: {{Impacting}} Mobility Trends and Insights for Noise Assessment and Mitigation},
  shorttitle = {The Future of Urban Sound Environments},
  author = {Can, Arnaud and L'Hostis, Alain and Aumond, Pierre and Botteldooren, Dick and Coelho, Margarida C and Guarnaccia, Claudio and Kang, Jian},
  date = {2020-01},
  journaltitle = {Applied Acoustics},
  shortjournal = {Appl. Acoust.},
  number = {170},
  pages = {pp1-8},
  doi = {10.1016/j.apacoust.2020.107518},
  abstract = {The de gradation of the sound environment contributes significantly to the external costs of mobility and is an obstacle to the development of cities. Action plans aiming at fighting traffic noise often take a long time to reach mature implementation. Therefore, it is advantageous to envisage how societal and urban changes and associated changes in mobility practices will modify the urban sound environment of tomorrow. In this article, an interdisciplinary team of seven researchers, whose work focuses on different fields of acoustics and mobility, reviews the potential impact of ongoing mobility and society changes on sound environments. First, the team identified the trends dealing with urban renewal, societal changes and new mobility drivers that have the greatest influence on sound environments, and analyzed in detail. From this analysis, insights emerged for urban noise impact and innovative noise mitigation solutions in the light of improved assessment of the links between mobility and urban sound environments.},
  keywords = {AMBIANCE SONORE,BRUIT EXTERIEUR,DEPLACEMENT URBAIN,FUTURE OF URBAN SOUND ENVIRONMENTS,INTERDISCIPLINARY DISCUSSION,MOBILITY TRENDS,NOISE MITIGATION,PROPAGATION,VILLE,ZONE URBAINE},
