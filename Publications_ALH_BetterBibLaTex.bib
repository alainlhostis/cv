@article{delaplaceLowcostAirlinesLowcost2015,
  title = {From Low-Cost Airlines to Low-Cost High-Speed Rail? {{The French}} Case},
  shorttitle = {From Low-Cost Airlines to Low-Cost High-Speed Rail?},
  author = {Delaplace, Marie and Dobruszkes, Frédéric},
