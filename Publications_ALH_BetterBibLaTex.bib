@article{andrisChallengesSocialFlows,
  title = {Challenges for Social Flows},
  author = {Andris, Clio and Liu, Xi and Ferreira Jr, Joseph},
  journaltitle = {Computers, Environment and Urban Systems},
  shortjournal = {Comput. Environ. Urban Syst.},
  issn = {0198-9715},
  doi = {10/gdvg9z},
  url = {https://www.sciencedirect.com/science/article/pii/S0198971516302307},
  urldate = {2018-04-10},
  abstract = {Social and interpersonal connections are attached to the built environment: people require physical infrastructure to meet and telecommunicate, and then populate these infrastructures with movement and information dynamics. In GIS analysis, actions are often represented as a unit of spatial information called the social flow–a linear geographic feature that evidences an individual's decision to connect places through travel, telecommunications and/or declaring personal relationships. These flows differ from traditional spatial networks (roads, etc.) because they are often non-planar, and unlike networks in operations systems (such as flight networks) provide evidence of personal intentionality to interact with the built environment and/or to perpetuate relationships with others. En masse, these flows sum to illustrate how humans, information and thoughts spread between and within places. Amid a growing abundance and usage of social flow data, we extend formal definitions of this data type, create new typologies, address new problems, and redefine social distance as the manifestation of social flows. Next, we outline challenges to fully leveraging these data with commercial GISystems by providing examples and potential solutions for representing, visualizing, manipulating, statistically analyzing and ascribing meaning to social flows. The goal of this discussion is to improve the dexterity of social flow data for geographic, environmental and social research questions.},
  keywords = {GIS,Origin/destination data,Social networks,Spatial data,Spatial interaction},
  note = {12 citations (Crossref) [2021-04-20]
\par
This philosophical idea has been described as\\
the contortion of Euclidean space—the pinching and expanding of\\
spatial features to better reflect one's perception of distance (Golledge \&\\
Hubert, 1982) or the costs of travel (L'Hostis, 2009).},
  file = {/home/lhostis/Zotero/storage/8IHK7R5H/1-s2.0-S0198971516302307-main.pdf;/home/lhostis/Zotero/storage/FZH3PJW5/S0198971516302307.html}
}

