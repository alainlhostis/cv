@article{tapiadorCharacterizingEuropeanHigh2009,
  title = {Characterizing {{European}} High Speed Train Stations Using Intermodal Time and Entropy Metrics},
  author = {Tapiador, Francisco J. and Burckhart, Kerstin and Martí-Henneberg, Jordi},
  date = {2009},
  journaltitle = {Transportation Research Part A: Policy and Practice},
  shortjournal = {Transp. Res. Part Policy Pract.},
  volume = {43},
  number = {2},
  pages = {197--208},
  issn = {0965-8564},
  doi = {10/fgkwxk},
  url = {http://www.sciencedirect.com/science/article/B6VG7-4V2X6JY-1/2/8ca3d37ab85b997f02ac36aba49e9db3},
  urldate = {2009-12-14},
  abstract = {This paper presents a quantitative method for characterizing high speed train stations in terms of passenger intermodality. The aim of the procedure is two-fold: firstly, the method is to be used as an objective measure for comparing stations in order to detect suboptimal points and improve the performance of stations as nodal points; secondly, the method provides a means to embed intermodality into regional accessibility models, allowing comprehensive modelling at lower scales. The empirical base of the work comprises data from 27 European high speed rail stations, which is deemed an appropriate statistical sample for the whole European rail network. Using the entropy metric, we found that several different patterns emerged: there was a clear hierarchy of stations which was linked to their respective roles within the system, while strong constraints impeded stations from performing optimally as true intermodal nodes.},
  keywords = {Entropy,High speed train station,Intermodality},
  file = {/home/lhostis/Zotero/storage/95I8353G/2008 characterising HSTstations.pdf;/home/lhostis/Zotero/storage/GEPRN9VE/science.html}
}

