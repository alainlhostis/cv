@article{dougierModellingElectricBus2023,
  title = {Modelling of {{Electric Bus Operation}} and {{Charging Process}}: {{Potential Contribution}} of {{Local Photovoltaic Production}}},
  shorttitle = {Modelling of {{Electric Bus Operation}} and {{Charging Process}}},
  author = {Dougier, Nathanael and Celik, Berk and Chabi-Sika, Salim-Kinnou and Sechilariu, Manuela and Locment, Fabrice and Emery, Justin},
  date = {2023-01},
  journaltitle = {Applied Sciences},
  shortjournal = {Appl. Sci.},
  volume = {13},
  number = {7},
  pages = {4372},
  publisher = {Multidisciplinary Digital Publishing Institute},
  issn = {2076-3417},
  doi = {10.3390/app13074372},
  url = {https://www.mdpi.com/2076-3417/13/7/4372},
  urldate = {2023-11-30},
  abstract = {The transition from diesel to electric buses allows the reduction of greenhouse gas emissions. However, the impacts of charging strategies on the quality of bus services and the utility grid must be assessed to ensure the feasibility of the energy transition in the public transportation sector. This study investigates the performances of different locations and sizes of charging infrastructures by presenting the comprehensive modelling of a bus network. It also estimates the potential benefits of a local photovoltaic (PV) production to reduce negative impacts on the utility grid. The presented approach is used for modelling one urban bus line in Compiègne, France, and simulations are performed for various case studies. The results demonstrate that the proposed method allows analysing the impact of the charging process on the quality of bus services by determining the delays of arrivals. The simulations also show the impacts of charger placement on bus on-board battery capacity, total peak power demand of battery charging, and PV self-consumption ratio. The amount of PV energy used directly to charge buses remains low, although it varies between scenarios. PV energy during winter is not sufficient to fully charge buses; however, it can be enough with additional stationary storage in the summer.},
  eid = {7},
  langid = {english},
  keywords = {bus fleet simulation model,charging stations,electric bus operation,GTFS data,photovoltaic systems},
  note = {1 citations (Semantic Scholar/DOI) [2023-11-30]}
}

