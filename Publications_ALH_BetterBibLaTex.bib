@article{brainardUsingIsochroneSurfaces1997,
  title = {Using Isochrone Surfaces in Travel-Cost Models},
  author = {Brainard, Julii S and Lovett, Andrew A and Bateman, Ian J},
  date = {1997},
  journaltitle = {Journal of Transport Geography},
  shortjournal = {J. Transp. Geogr.},
