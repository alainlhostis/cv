@article{maNodeplaceModelExtended2022,
  title = {Node-Place Model Extended by System Support: {{Evaluation}} and Classification of Metro Station Areas in {{Tianfu}} New Area of {{Chengdu}}},
  shorttitle = {Node-Place Model Extended by System Support},
  author = {Ma, Jiexi and Shen, Zhongwei and Xie, Yi and Liang, Pengpeng and Yu, Bingjie and Chen, Li},
  date = {2022-09-19},
  journaltitle = {Frontiers in Environmental Science},
  shortjournal = {Front. Environ. Sci.},
  volume = {10},
  publisher = {Frontiers},
  issn = {2296-665X},
  doi = {10.3389/fenvs.2022.990416},
  url = {https://www.frontiersin.org/journals/environmental-science/articles/10.3389/fenvs.2022.990416/full},
  urldate = {2025-12-03},
  abstract = {The construction of new urban areas has become one of the important ways for urban regeneration throughout the process of polycentric urban development. New urban area construction following transit-oriented development (TOD) conception advocates development around the public transportation stations. To gain more benefits around the stations, it is necessary to conduct an ex-ante evaluation of TOD projects in the new urban area. The Node-place (NP) model is a commonly used method for TOD evaluation and classification, which essentially designed an analytical framework for assessing station areas in both transport (node) and land use (place) aspects. The objective of our study is twofold. First, based on the original NP model, we propose the node-place-system support (NPS) model by introducing a novel evaluation dimension – system support – which quantitatively describes the relationship between local stations and the overall urban system. Second, taking advantage of multi-sourced data and Geographical Information System (GIS) techniques, we employ the proposed NPS model to evaluate and classify the metro stations in the Tianfu New Area of Chengdu, China. The results show that most stations present a balanced relationship between transport and land use performances. However, for a fraction of these balanced stations, we observe a mismatch between the system support and NP performances. Accordingly, we identify the system-mismatched stations and provide targeted improvement strategies for urban design.},
  langid = {english},
  keywords = {Metro station,Node-place model,Tianfu new area,TOD,urban planning},
  file = {/home/lhostis/Zotero/storage/BZAY7BFX/Ma et al. - 2022 - Node-place model extended by system support Evaluation and classification of metro station areas in.pdf}
}

@article{manoutAssessingRoleDaily2021,
  title = {Assessing the {{Role}} of {{Daily Activities}} and {{Mobility}} in the {{Spread}} of {{COVID-19}} in {{Montreal With}} an {{Agent-Based Approach}}},
  author = {Manout, Ouassim and Ciari, Francesco},
  date = {2021},
  journaltitle = {Frontiers in Built Environment},
  shortjournal = {Front. Built Environ.},
  volume = {7},
  issn = {2297-3362},
  doi = {10.3389/fbuil.2021.654279},
  url = {https://www.frontiersin.org/articles/10.3389/fbuil.2021.654279},
  urldate = {2023-11-24},
  abstract = {Daily activities and mobility dynamics play a central role in the spread of COVID-19. Close physical interactions involved by certain daily activities help transmit the virus. Travel required by the spatial distribution of activities contributes to the propagation of the virus. In order to control and limit this propagation, it is critical to understand the contribution of daily activities to the dynamics of COVID-19. This paper investigates the connection between daily activities, their distribution in space and time, the characteristics of the individuals performing them, and the transmission of the virus. A business-as-usual agent-based simulation scenario of Montreal, Canada is used. To address this research question, we use two agent-based models: MATSIM and EPISIM. MATSIM simulates daily activities and mobility dynamics of the population. EPISIM simulates the spread of the virus in the population using contact networks computed by MATSIM. A synthetic population of Montreal is defined to replicate the main observed sociodemographic characteristics of Montrealers as well as their activity and mobility patterns. The definition of the synthetic population relies on various data sources: household travel survey, census, real estate, car ownership, and housing data. In the business-as-usual scenario, findings underline the significant role of home, work, and school activities in community transmission of COVID-19. Secondary activities, including leisure and shopping, also help spread the virus, but to a lesser degree in comparison with primary activities. The risk of infection in the workplace depends on the economic sector. Healthcare workers are, by far, the most exposed workers to the virus. Workplace infections mirror the gender-biased job market of Montreal. Most infections in the healthcare and educational services are among women. Most infections in the manufacturing, construction, transportation, and warehousing industries are among men. In the business-as-usual scenario where community transmission is high, primary and secondary school-aged children are found to be a major transmission vector of the virus. Finally, simulation results suggest that the risk of infection in the public transportation system is low.}
}

@inproceedings{manoutModelingCOVID19Pandemic2021,
  title = {Modeling the {{COVID-19 Pandemic}}: {{A Sensitivity Analysis}} on {{Input Data Using Agent-Based Transportation Simulation}}},
  shorttitle = {Modeling the {{COVID-19 Pandemic}}},
  booktitle = {Transportation {{Research Board}} ({{TRB}})},
  author = {Manout, Ouassim and El-Megzari, Idriss and Ciari, Francesco},
  date = {2021-01},
  location = {Washington, DC (virtual), United States},
  url = {https://hal.science/hal-03300172},
  urldate = {2023-11-24},
  abstract = {The COVID-19 pandemic has rampaged through the world causing hundreds of thousands of fatalities, millions of infections, and acute economic and social consequences. In this context, epidemiological models have been put forward as key tools to help public health authorities and policy makers cope with the pandemic. In some cases, these models have proved to be useful aid-decision tools. Nonetheless, in several instances, these models still face several shortcomings and challenges. First, most popular epidemic models still rely on an aggregate representation of the population. Second, the reliability and accuracy of these models in the presence of biased input data is yet to be tested. In this research, we address these two challenges by conducting a sensitivity analysis on the impact of bias in input data, using a transportation agent-based model (MATSIM), and a MATSIM-dependent epidemic model, EPISIM. Our findings stress that epidemic predictions are sensitive towards bias in input data. The underestimation of confirmed infections and the overestimation of the rate of fatalities in official public health reports, bias modeling outcomes. We found that when such biased data are used to train EPISIM, predictions of severe cases and infections are often overestimated. This overestimation bias conveys a false picture of the dynamics of the pandemic. The policy implications of these findings are of interest to both researchers and policy makers.},
  keywords = {agent-based,COVID-19,data bias,epidemic,EPISIM,MATSIM,modeling,transportation}
}

@article{mansouriExtractingUniqueDiscussions2023,
  title = {Extracting {{Unique Discussions}} of {{Interests}} for {{Entrepreneurs}} and {{Managers}} in a {{Set}} of {{Business Tweets Without Any Human Bias}}},
  author = {Mansouri, Jafar and Cavarretta, Fabrice and Swaileh, Wassim and Kotzinos, Dimitris},
  date = {2023},
  journaltitle = {IEEE Access},
  volume = {11},
  pages = {144258--144273},
  issn = {2169-3536},
  doi = {10.1109/ACCESS.2023.3343756},
  url = {https://ieeexplore.ieee.org/document/10363172},
  urldate = {2024-01-29},
  abstract = {This study proposes a framework for extracting unique discussions of the interests of managers and entrepreneurs on Twitter (X). By unique discussions of interests, we mean those that are more tweeted by these communities but rarely by public people. These discussions can be facts and/or sentiments related to some topics. Since this is a subjective problem, human intervention can lead to bias in the results. Therefore, we propose an unsupervised method with zero information about the context since prior knowledge stems from human intervention. Consequently, there is no real ground truth. To retrieve such discussions of interests, first, unique tweets (discussions) are identified in two stages. In the first stage, a scoring algorithm is proposed that gives a score to each tweet of a specific year and tweets are sorted based on their scores. Different sets of tweets are selected based on their scores and considered automatically created ground truths. In the next stage, an unsupervised convolutional neural network trained on the created ground truth is used for the classification of tweets of other years (whether they are unique to these communities). Finally, latent Dirichlet analysis is applied to the detected unique tweets to give the most common interest topics discussed by these communities. Experimental analysis is performed on tweets from 2017-2019. The results reveal these communities’ attitudes and highlight interesting common and different topics discussed between managers and entrepreneurs; some of them can be difficult for humans to predict in advance. The proposed approach is applicable to any community.},
  eventtitle = {{{IEEE Access}}},
  keywords = {Blogs,Business,Business intelligence,Entrepreneurs,Entrepreneurship,Feature extraction,Management,managers,Mathematics,opinion mining,Sentiment analysis,Social networking (online),topic extraction,unique discussions of interests,unsupervised classification,Unsupervised learning,Videos},
  note = {0 citations (Semantic Scholar/DOI) [2024-01-29]}
}

