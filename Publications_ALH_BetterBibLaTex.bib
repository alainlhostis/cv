@inproceedings{hacquardMeasuring15MinuteCity2026,
  title = {Measuring the 15-{{Minute City}}: {{New Trends}} in {{Literature}}},
  shorttitle = {Measuring the 15-{{Minute City}}},
  booktitle = {Transport {{Research Arena}} 2026},
  author = {Hacquard, Clement and Hachette, Maxime and L'Hostis, Alain},
  date = {2026-10},
  publisher = {European Commission},
  location = {Budapest, Hungary},
  doi = {10.1007/978-3-032-37192-8_15},
  url = {https://hal.science/hal-05633084},
  urldate = {2026-06-01},
  abstract = {Proximity-related concepts such as the 15-minute city (15mc) are increasingly more present in political discourse and in scientific literature. One of the main questions in literature is whether a city or a territory attains proximity-related goals. Previous reviews have been written on papers before 2023. We performed a systematic literature review of 102 papers using quantitative approaches to the 15mC or close notions such as 20-Minute Neighborhoods between 2023 and 2025. These articles use various methods applied to different scales ranging from a neighborhood to multiple urban areas. Most of the papers use thresholds and even the ones referring to the 15mC concept show variability in the way it is assessed as modes considered, and speeds vary between studies, and we investigate these thresholds to analyze how large the 15mC is. We observed emerging trends and compared the methodologies of the reviewed studies with the findings of previous reviews that identified several shortcomings to verify if they were overcome.},
  keywords = {15-minute City,20-minute neighbourhood,Proximity,Systematic literature review},
  annotation = {HAL:halshs-05633084},
  file = {/home/lhostis/Zotero/storage/YKJIZ8SD/hal-05633084.html}
}

@thesis{haffnerLimpactFormesUrbaines2022,
  type = {phdthesis},
  title = {L’impact des formes urbaines dans la mise en place des politiques de transition énergétique : une approche par la modélisation},
  shorttitle = {L’impact des formes urbaines dans la mise en place des politiques de transition énergétique},
  author = {Haffner, Maud},
  date = {2022-04-01},
  number = {2022ENPC0011},
  institution = {École des Ponts ParisTech},
  doi = {10.70675/c4944dc2zaeb5z4f9az9049z7bf1d2e874eb},
  url = {https://pastel.hal.science/tel-03676292},
  urldate = {2024-01-30},
  abstract = {La sobriété énergétique apparaît comme un élément central de la ville durable face à la problématique du réchauffement climatique et aux difficultés croissantes d’approvisionnement énergétique. Environ 50 \% de l’énergie finale consommée en France est utilisée directement par les individus, c’est à dire dans les bâtiments pour les besoins de chauffage, d’éclairage ou encore d’électricité spécifique (29 \%) et dans les transports pour se déplacer quotidiennement (20 \%). Ces deux secteurs apparaissent ainsi comme deux champs d’action majeurs permettant de réduire significativement la consommation globale d’énergie. Ces consommations dépendent de plusieurs facteurs, comme le climat, les comportements, la technologie mais également la forme urbaine. Ce travail propose une réflexion sur les interactions entre la forme urbaine et les consommations énergétiques individuelles. Pour questionner ces interactions et donner de nouveaux éclairages sur cette question, nous proposons (1) de recourir à des villes archétypales comme terrains d’études et (2) d’avoir une approche de modélisation désagrégée des pratiques générant des consommations énergétiques. La première proposition permet d’avoir des territoires « standardisés », représentatifs des villes en France, caractérisés par des formes variées à toutes les échelles considérées et entièrement paramétrables. La seconde proposition qui place l’individu et son lieu de vie au cœur de la modélisation permet de spatialiser l'énergie et ainsi de combiner à la fois le secteur des transports et celui du bâtiment. Ce travail est réalisé à l’aide de la plateforme de simulations des mobilités quotidiennes MobiSim-Soft et à l’aide de la plateforme de simulation des consommations résidentielles CityEnergyAnalyst (CEA). Finalement, les résultats de ce travail de thèse montrent l’intérêt de la méthode villes archétypales – modélisation désagrégée des pratiques, en nous permettant de conduire une analyse systémique et multi-échelles des effets de la forme urbaine sur les consommations énergétiques.},
  langid = {french},
  keywords = {Aménagement du territoire,Archetypal cities,Daily mobility,enc,Energy simulations,Formes urbaines,Mobilité quotidienne,Modélisation spatiale,Simulations énergétiques,Spatial modelling,Urban forms,Urban planning,Villes archétypales},
  annotation = {HAL: tel-03676292},
  note = {Direction : A. L'Hostis},
  file = {/home/lhostis/Zotero/storage/TMJ5RMPX/Haffner - 2022 - L’impact des formes urbaines dans la mise en place.pdf;/home/lhostis/Zotero/storage/ZPYM72TI/Haffner - 2022 - L'impact des formes urbaines dans la mise en place des politiques de transition énergétique  une ap.pdf}
}

