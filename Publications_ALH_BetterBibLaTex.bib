@thesis{hachedErgonomieDaccesAux2019,
  type = {phdthesis},
  title = {Ergonomie d'accès aux ressources de la vie quotidienne en mobilité douce : application à l'Eurométropole de Strasbourg},
  shorttitle = {Ergonomie d'accès aux ressources de la vie quotidienne en mobilité douce},
  author = {Hached, Wassim},
  date = {2019-12-06},
  institution = {Université de Strasbourg},
  url = {https://theses.hal.science/tel-02897944},
  urldate = {2023-12-08},
  abstract = {Aujourd’hui, de nombreuses agglomérations cherchent à promouvoir les mobilités durables. Leurs politiques conduisent à réduire la place de l'automobile, à développer les aménagements piétonniers et cyclables et/ou à renouveler les transports en commun. Se pose alors la question des effets de ces politiques sur les conditions d'accès aux ressources du quotidien. Les aménagements en faveur de la mobilité durable sont-ils configurés de façon à permettre la satisfaction des besoins de l’ensemble de la population ? Les modes doux offrent-ils une alternative crédible à la voiture ? Globalement ou de façon sélective ? Pour y répondre, cette thèse présente une démarche d’analyse géographique fondée sur le concept d’ergonomie spatiale. L’application à 13 zones tests, à l’aide d’un système d’information géographique, a permis de révéler des situations clivantes au sein de l’Eurométropole de Strasbourg, d’étudier finement les situations différenciées et de les mettre en perspective des profils socio-démographiques pour en analyser les disparités sociospatiales.},
  langid = {french},
  file = {/home/lhostis/Zotero/storage/E767C6GW/Hached - 2019 - Ergonomie d'accès aux ressources de la vie quotidi.pdf}
}

@article{hachedExploringConceptMobility2023,
  title = {Exploring the Concept of " Mobility Hubs " and Assessing Their Impacts in Two {{European}} Cities},
  author = {Hached, Wassim and L'Hostis, Alain and Gragera, Albert},
  date = {2023-01-01},
  journaltitle = {Transportation Research Procedia},
  shortjournal = {Transp. Res. Procedia},
  series = {{{TRA Lisbon}} 2022 {{Conference Proceedings Transport Research Arena}} ({{TRA Lisbon}} 2022),14th-17th {{November}} 2022, {{Lisboa}}, {{Portugal}}},
