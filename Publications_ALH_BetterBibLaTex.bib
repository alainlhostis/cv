@article{baquerolarrivaFlowersProximitySpain2014,
  title = {Flowers of Proximity in {{Spain}}: Understanding Local Context Priorities},
  shorttitle = {Flowers of Proximity in {{Spain}}},
  author = {Baquero Larriva, María Teresa and Lamíquiz Daudén, Francisco},
  date = {2014},
  eprint = {10317/13588},
  eprinttype = {hdl},
  publisher = {Universidad Politécnica de Cartagena},
  url = {http://hdl.handle.net/10317/13588},
  urldate = {2024-11-24},
  abstract = {Proximity planning models are globally implemented to promote ecological, health, and equity ob-jectives. As a difference with accessibility, an objective and continuous variable, it is thought that the idea of proximity is intrinsically subjective and reliant on the context, without a universal model that can be applied to all cities due to their diverse social, economic, and geographical backgrounds. The study aims to evaluate the efficacy of the “flower of proximity” as a new participatory tool to examine accessibility preferences based on proximity in Madrid and Beasain and to build a more objetive picture of shared, social, needs. It acknowledges the necessity for easy understandable and context-specific proximity instruments to promote effective urban planning strategies that address the unique needs of the local populace.},
  langid = {english},
  file = {/home/lhostis/Zotero/storage/7S2JSUJ9/Baquero Larriva and Lamíquiz Daudén - 2014 - Flowers of proximity in Spain understanding local context priorities.pdf}
}

@online{baqueroReintroducingProximityConcerns2024,
  type = {SSRN Scholarly Paper},
  title = {Reintroducing {{Proximity Concerns}} for {{Urban Planning Practitioners Through}} the “{{Flower}} of {{Proximity}}” as a {{Participatory Tool}}. {{The Cases}} of {{Madrid}} and {{Munich}}},
  author = {Baquero, María Teresa and Seisenberger, Sebastian and Lamíquiz, Patxi and Ramírez, Alba and Büttner, Benjamin},
  date = {2024-04-24},
  number = {4805921},
  eprint = {4805921},
  eprinttype = {Social Science Research Network},
  location = {Rochester, NY},
  doi = {10.2139/ssrn.4805921},
  url = {https://papers.ssrn.com/abstract=4805921},
  urldate = {2025-01-07},
  abstract = {Efforts to improve urban life urgently require solutions focused on existing cities, emphasising proximity urbanism models such as the 15-minute City (15mC). This model aims to enhance sustainable mobility by strategically placing essential services near residents' homes. However, its implementation faces historical challenges stemming from previous urban planning focused on automobiles, necessitating adjustments to suit local circumstances. Despite a growing discourse on proximity to daily destinations, the views of local planning practitioners regarding the necessities and obstacles of the 15mC still need to be explored.This research aims to address this gap by a) Assessing urban planning practitioners' understanding and preferences for proximity-based accessibility in daily activities; b) Investigating their perceptions regarding the challenges and opportunities associated with implementing the 15-minute City (15mC) concept locally; c) Testing the efficacy of the playful "Flower of proximity" methodology as a tool to overcome accessibility challenges. Structured workshops were conducted with practitioners in Madrid and Munich to achieve this.Similar preferences for amenities within the 15mC radius among practitioners in both cities were found. Playgrounds, pharmacies, bakeries, and public transport were perceived as essential services that should be located closer to residents’ homes. Both workshops highlighted long implementation processes and political commitment as barriers to the 15mC’s implementation. The flower of proximity was found to be valuable in visualizing diverse accessibility requirements, fostering participatory discussions, and achieving shared goals. It acts as a promising aid for establishing shared priorities in implementing proximity policies and encouraging collaborative efforts towards resilient, liveable, and human-centric urban spaces.},
  langid = {english},
  pubstate = {prepublished},
  keywords = {15-minute city,accessibility,participatory tools,proximity planning,urban planning},
  file = {/home/lhostis/Zotero/storage/DJYHYDAB/Baquero et al. - 2024 - Reintroducing Proximity Concerns for Urban Planning Practitioners Through the “Flower of Proximity”.pdf}
}

