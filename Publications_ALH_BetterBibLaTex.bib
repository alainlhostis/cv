  file = {/home/lhostis/Zotero/storage/3BV8I2WT/Delaplace et al. - 2014 - High-speed Rail Station, Service Innovations And T.pdf;/home/lhostis/Zotero/storage/T3SC4HCN/hal-01098709.html}
