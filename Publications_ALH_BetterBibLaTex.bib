  title = {La {{Cartographie}} Des Espaces Fonctionnels},
  author = {Müller, Jean-Claude},
  date = {1983},
  journaltitle = {L'Espace géographique},
  shortjournal = {Espace Géographique},
  volume = {12},
  number = {2},
  eprint = {44380186},
  eprinttype = {jstor},
  pages = {142--152},
  issn = {0046-2497},
  doi = {10/ggw6cc},
  url = {https://www.jstor.org/stable/44380186},
  urldate = {2019-02-25},
  abstract = {[A la suite de travaux préliminaires publiés récemment dans cette revue, on suggère de nouvelles solutions au problème de la cartographie des distances non-euclidiennes. Les procédés d'échelonnage multidimensionnel s'avèrent insatisfaisants, dans la mesure où ils impliquent une représentation euclidienne ou minkowskienne en contradiction avec la métrique des données. Plutôt que d'optimiser la représentation des données sur un fond géométrique connu, on propose de transformer l'échelle de la carte pour l'adapter à la géométrie (inconnue) des données. Quelques exemples appliqués à la cartographie des distances-efforts et métaphoriques montrent l'utilité de la méthode pour l'analyse et l'interprétation géographiques. Following preliminary work already published in this journal, new solutions to the problem of mapping non-Euclidean distances are suggested. Multidimensional scaling procedures are unsatisfactory, to the extent that they imply an Euclidean or Minkowskian representation in contradiction with the data metric. Rather than optimazing the representation of the data on a geometrically known surface, we propose to transform the scaling of the map in accordance with the geometry (unknown) of the data. Some examples applied to the mapping of effort and metaphoric distances show the use of the method for geographical analysis and interpretation.]}
}

