  author = {Cerqueira, Eugênia Dória Viana and Motte-Baumvol, Benjamin and Chevallier, Leslie Belton and Bonin, Olivier},
  date = {2020-06-01},
  journaltitle = {Transportation Research Part D: Transport and Environment},
