@article{balanFrameworkEnhancingBicycle2027,
  title = {Framework for Enhancing Bicycle Parking Infrastructure at Metro Stations Based on User Perception},
  author = {Balan, Niyatha and Pandit, Debapratim},
  date = {2027-01-01},
  journaltitle = {Travel Behaviour and Society},
  shortjournal = {Travel Behav. Soc.},
  volume = {46},
  pages = {101426},
  issn = {2214-367X},
  doi = {10.1016/j.tbs.2026.101426},
  url = {https://www.sciencedirect.com/science/article/pii/S2214367X2600195X},
  urldate = {2026-10-30},
  abstract = {Ensuring high-quality bicycle parking that meets user preferences is essential for effective bicycle–transit integration. While most studies focus on bicycle parking provision, including availability, location, and occupancy optimisation, limited attention has been given to the relative importance of these factors for user satisfaction, particularly in facilitating bicycle-to-metro transfers. Moreover, the existing discussions do not present a comprehensive, context-specific set of factors that shape user satisfaction. This study addresses these gaps by examining the determinants of user satisfaction with bicycle parking facilities near metro stations to inform prioritisation of improvements and enhance service quality. A questionnaire survey of bicycle–metro users in Kolkata, India, yielded 420 valid responses across four stations with varying parking conditions. Importance and satisfaction ratings were collected for 17 attributes identified through a literature review, researcher’s judgment, and context-specific considerations related to bicycle–metro integration. Revised Importance–Performance Analysis (Revised IPA) was employed to evaluate bicycle parking service quality, as it simultaneously considers importance and satisfaction while overcoming the limitations of traditional IPA. Implicit importance, explicit importance, and perceived satisfaction values are considered to identify the factor structures and management schemes. Finally, priority attributes and the sequence of resource allocation are determined by comparing the management schemes and factor structures. The attributes with the highest priority for resource allocation to improvement include ‘availability of managed bicycle parking at the station’, ‘walking distance from the parking location to the entrance’, and ‘availability of flexible booking plans’.The findings can guide the metro authority on prioritising infrastructure enhancements to facilitate cycle-transit users.},
  keywords = {Bicycle infrastructure,Bicycle Parking,Bicycle parking service quality,Bicycle-transit transfer,Revised Importance-Performance Analysis},
  note = {premiere citation de l’introduction: Integrating micromobility with transit extends catchment areas and ridership (\href{https://www.sciencedirect.com/science/article/pii/S2214367X2600195X?casa_token=pOyZbrFuTi0AAAAA:JNjr2332wS6-NmsWL0NYuqDN9GPHDbYphQlM6aFHQvl5JpbLhgEyu50fjVct6q0XjRLrKFky\#b0185}{Moinse and L’Hostis, 2024}).},
  file = {/home/lhostis/Zotero/storage/F7RK5XBF/Balan and Pandit - 2027 - Framework for enhancing bicycle parking infrastructure at metro stations based on user perception.pdf;/home/lhostis/Zotero/storage/7KMGKTQJ/S2214367X2600195X.html}
}

@article{baldasseroniPaveBatiAu2019,
  title = {Du pavé bâti au pavé battu : les mobilisations des usagers pour les infrastructures de voirie et leur prise en compte politique, Lyon, années 1950-1970},
  shorttitle = {Du pavé bâti au pavé battu},
  author = {Baldasseroni, Louis},
  date = {2019-12-31},
  journaltitle = {Métropoles},
  number = {25},
  publisher = {ENTPE},
  issn = {1957-7788},
  doi = {10/ggw565},
  url = {http://journals.openedition.org/metropoles/6974},
  urldate = {2020-03-07},
  abstract = {La rue est un terrain d'expression bien connu en sciences humaines. Elle est aussi un enjeu de mobilisation par ses infrastructures de voirie : les demandes, réclamations et oppositions peuvent être très variées, allant de la simple demande d'un passage pour piétons à des oppositions à des projets de transformation plus importants. Territoire du quotidien, la rue a constitué un important ciment de mobilisations depuis la fin du XIXe siècle et semble décliner comme cadre de revendications à partir des années 1960. Cela est dû à la diversification des acteurs mobilisés, de leurs demandes et de leurs actions, que les pouvoirs publics ont du mal à intégrer dans les cadres habituels. Cependant, certaines rues font l’objet de mouvements d’opposition à l’action publique et deviennent des terrains d’action dans les années 1970, alors que les demandes adressées aux services de voirie concernent des infrastructures mineures (marquage au sol, feux de signalisation).},
  eid = {25},
  langid = {french},
  note = {0 citations (Crossref) [2021-04-20]}
}

@article{baltazarDESIGNSUSTAINABLEMOBILITY2023,
  title = {{{TOWARDS THE DESIGN OF SUSTAINABLE MOBILITY SYSTEMS}}: {{OBJECTIVES AND BARRIERS FROM THE FRENCH LOCAL AUTHORITIES}}’ {{PERSPECTIVE}}},
  shorttitle = {{{TOWARDS THE DESIGN OF SUSTAINABLE MOBILITY SYSTEMS}}},
  author = {Baltazar, Julien and Bouillass, Ghada and Vallet, Flore and Puchinger, Jakob and Perry, Nicolas},
  date = {2023-07},
  journaltitle = {Proceedings of the Design Society},
  shortjournal = {Proc. Des. Soc.},
  volume = {3},
  pages = {3621--3630},
  publisher = {Cambridge University Press},
  issn = {2732-527X},
  doi = {10.1017/pds.2023.363},
  url = {https://www.cambridge.org/core/journals/proceedings-of-the-design-society/article/towards-the-design-of-sustainable-mobility-systems-objectives-and-barriers-from-the-french-local-authorities-perspective/A0B43D0E1AEED9F01C47EF3E713DF852},
  urldate = {2024-01-06},
  abstract = {Within the on-going ecological transition, mobility systems are considered as sociotechnical systems that raise several challenges for local authorities due to the different levels of decision, a complex stakeholder network and the numerous objectives to be dealt with. Designers are therefore seeking to develop new frameworks to support local authorities moving towards more sustainable mobility systems. Based on the French context, this study relies on an analysis of the regulation and an interview-based survey that depict the mobility design from the local authorities’ perspective. First, it investigates the objectives defined in the law and the difficulties met by local authorities. Then, it highlights the main political, organisational, and knowledge barriers for sustainable mobility. Finally, it proposes a set of recommendations to create a framework to better define and prioritise the objectives, ensure efficient planning and monitoring, clarify the interactions between actors, and enhance mobility plans.},
  langid = {english},
  keywords = {Decision making,Local authorities,Mobility,Organizational processes,Sustainability},
  note = {0 citations (Semantic Scholar/DOI) [2024-01-07]}
}

