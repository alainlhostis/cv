@inproceedings{buchinTravelTimeMapsLinear2014,
  title = {Travel-{{Time Maps}}: {{Linear Cartograms}} with {{Fixed Vertex Locations}}},
  shorttitle = {Travel-{{Time Maps}}},
  booktitle = {Geographic {{Information Science}}},
  author = {Buchin, Kevin and family=Goethem, given=Arthur, prefix=van, useprefix=true and Hoffmann, Michael and family=Kreveld, given=Marc, prefix=van, useprefix=true and Speckmann, Bettina},
