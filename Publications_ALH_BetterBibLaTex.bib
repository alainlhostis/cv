@article{mussireyeroEvolutionPoliticalOpinion2021,
  title = {Evolution of the Political Opinion Landscape during Electoral Periods},
  author = {Mussi Reyero, Tomás and Beiró, Mariano G. and Alvarez-Hamelin, J. Ignacio and Hernández, Laura and Kotzinos, Dimitris},
  date = {2021-12},
  journaltitle = {EPJ Data Science},
