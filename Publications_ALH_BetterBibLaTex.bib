@article{chavaGentrificationNewbuildOldbuild2019,
  title = {Gentrification in New-Build and Old-Build Transit-Oriented Developments: The Case of {{Bengaluru}}},
  shorttitle = {Gentrification in New-Build and Old-Build Transit-Oriented Developments},
  author = {Chava, Jyothi and Newman, Peter and Tiwari, Reena},
  date = {2019-07-03},
