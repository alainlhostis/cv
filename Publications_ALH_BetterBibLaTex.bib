@article{ritsemavaneckAccessibilityAnalysisSpatial1999,
  title = {Accessibility Analysis and Spatial Competition Effects in the Context of {{GIS}}-Supported Service Location Planning},
  author = {Ritsema van Eck, J. R and family=Jong, given=T, prefix=de, useprefix=true},
  date = {1999},
  journaltitle = {Computers, Environment and Urban Systems},
