  shorttitle = {Need-Based Travel Behavior Analysis},
  author = {Di Ciommo, Floridea and Pagliara, Francesca and De Crescenzo, Maurizio},
  date = {2018},
  journaltitle = {Transportation Research Procedia},
  shortjournal = {Transp. Res. Procedia},
  series = {Transport {{Survey Methods}} in the Era of Big Data:Facing the Challenges},
  volume = {32},
  pages = {110--118},
  issn = {2352-1465},
  doi = {10/ggw57m},
  url = {http://www.sciencedirect.com/science/article/pii/S2352146518301741},
  urldate = {2019-03-01},
  abstract = {This paper defines a need-based theoretical framework for evaluating transport policies and investment. It focuses on the assessment of personal transport needs as a fundamental part of human rights and social inclusion. The paper starts by elaborating a need-based methodology, where users’ satisfaction together with the identified time threshold define types of trips (i.e. origin-destination, purpose, mode, and distance), which help to identify if mobility needs are covered or not. This paper focuses on how to use traditional survey mobility data for checking the satisfaction of users’ needs. The dataset includes the mobility survey carried out in the Barcelona Metropolitan Area during 2013. The results aim to show planners and policy makers where to direct their policies and transport investments in public transport networks and services.},
  keywords = {measuring inaccessibility,People's needs mobility Survey,People’s needs mobility Survey,time threshold},
  file = {/home/lhostis/Zotero/storage/2CEUYKD4/Di Ciommo et al. - 2018 - Need-based travel behavior analysis new potential.pdf;/home/lhostis/Zotero/storage/4VZKYP6U/S2352146518301741.html}
