@article{kilaniMultimodalTransportModel2022,
  title = {A {{Multimodal Transport Model}} to {{Evaluate Transport Policies}} in the {{North}} of {{France}}},
  author = {Kilani, Moez and Diop, Ngagne and De Wolf, Daniel},
  date = {2022-01},
  journaltitle = {Sustainability},
