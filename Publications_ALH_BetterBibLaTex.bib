  doi = {10/ggz8rk},
  url = {https://www.persee.fr/doc/aru_0180-930x_2018_num_113_1_3277},
  urldate = {2020-06-13},
  abstract = {La densification a progressivement été érigée par les politiques publiques en modèle urbanistique optimal, que le renforcement des législations impose aux communes. Ce modèle n’est pourtant pas adapté à toutes les situations, notamment lorsqu’il s’applique aux centres historiques – déjà denses – des communes périurbaines franciliennes, où sa réalisation demeure compliquée (coût élevé, manque d’ingénierie). De plus, la densification n’est pas toujours porteuse de qualité architecturale et urbaine : les constructions résultant de ce modèle de développement se traduisent par un nouveau standard architectural, pastichant, qui bien souvent néglige son inscription dans un projet local urbain et paysager.},
  langid = {fre}
}

