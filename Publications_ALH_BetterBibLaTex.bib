@article{chenDevelopmentHistoryAccessibility2018,
  title = {Development History and Accessibility Evolution of Land Transportation Network in {{Beijing-Tianjin-Hebei}} Region over the Past Century},
  author = {Chen, Yu and Jin, Fengjun and Lu, Yuqi and Chen, Zhuo and Yang, Yu},
  date = {2018-10-01},
  journaltitle = {Journal of Geographical Sciences},
  shortjournal = {J. Geogr. Sci.},
  volume = {28},
  number = {10},
  pages = {1500--1518},
  issn = {1861-9568},
  doi = {10/gjqhc2},
  url = {https://doi.org/10.1007/s11442-018-1558-x},
  urldate = {2021-04-15},
  abstract = {From the development of modern transportation to the current era of high-speed transportation networks, the Beijing-Tianjin-Hebei (BTH) region has always played a national leading role in land transportation development of China. In order to explore the long-term evolutionary characteristics of land transportation in the BTH region, this paper utilized a temporal scale of 100 years to systematically interpret the development process of the land transportation network. Taking 13 cities within the BTH region as research anchor cities, we took into account “leaping” mode of transportation in order to investigate the evolution of accessibility. Our research shows the following results: (1) The land transportation network in the BTH region has undergone five stages of development: the initial period of modernization (1881–1937); the period of stagnation of transportation development (1937–1949); the network expansion period (1949–1980); the period of trunk construction (1980–1995), and the period of high-speed transportation network development (1995–present). The network structure centered around Beijing has existed from the outset of modern transportation development. (2) The accessibility spatial pattern of land transportation in BTH region has evolved from expansion along traffic corridors to the formation of concentric circles. The stratified circular structure of transportation in anchor cities has gradually developed into a contiguous development pattern. (3) There are clear hierarchical differences in the transportation structures of anchor cities. Beijing has always been at the top of this hierarchy, while the hierarchical position of Zhangjiakou has fallen noticeably since 1949. The Beijing-Tianjin region was the first region to form a short-duration transportation circle structure, while the transportation advantages of the central part of Hebei Province, which is located in the center of the BTH transportation region, have yet to be realized.},
  langid = {english}
}

@article{chenIdentifyingDetourPatterns2026,
  title = {Identifying Detour Patterns of Rail Feeder Bus Routes: {{A}} City-Scale Analysis},
  shorttitle = {Identifying Detour Patterns of Rail Feeder Bus Routes},
  author = {Chen, Enhui and Sun, Zhitong and Ji, Keyu and Teng, Jing},
  date = {2026-12-01},
  journaltitle = {Journal of Transport Geography},
  shortjournal = {J. Transp. Geogr.},
  volume = {137},
  pages = {104816},
  issn = {0966-6923},
  doi = {10.1016/j.jtrangeo.2026.104816},
  url = {https://www.sciencedirect.com/science/article/pii/S096669232600270X},
  urldate = {2026-10-30},
  abstract = {Feeder bus services are essential for extending the service coverage of urban rail transit systems, yet feeder-route detour and its supply–demand matching remain insufficiently understood at the city scale, particularly in terms of spatial heterogeneity, underlying mechanisms, and implications for feeder service design. This study develops an integrated framework for feeder-route detour identification, typology, and supply–demand diagnosis by incorporating bus network topology, multidimensional route indicators, deep embedded clustering, and spatially explicit mismatch analysis. A case study is conducted in Nanjing, China, using rail and bus network data, land-use data, and smart card data. The results reveal five distinct feeder-route types with different physical meanings. Supply–demand mismatch varies systematically across route types. Relatively direct routes are not always associated with strong demand, while highly detoured routes may reflect either genuine inefficiency or deliberate coverage-oriented service provision. High-demand routes are concentrated in and around the city center, whereas low-demand routes are more widely distributed across intermediate and peripheral areas. Feeder-route detour is not a uniform manifestation of poor design, but a spatially differentiated outcome shaped by urban form, barrier conditions, and service strategy. By moving beyond conventional directness measures toward typology-based and spatially explicit diagnosis, this study provides new evidence for understanding feeder bus detour and offers practical implications for feeder-route optimization, station-area accessibility improvement, and transit equity.},
  keywords = {Built environment,City-scale analysis,Deep embedded clustering,Detour pattern identification,Rail feeder bus,Supply–demand mismatch},
  note = {More broadly, recent intermodal research has also emphasized that detours and indirect access may arise from the spatial organization of multimodal systems rather than from poor design alone (\href{https://www.sciencedirect.com/science/article/pii/S096669232600270X?casa_token=SSpaec9qqgQAAAAA:qx4YX-ZS6z-hWKhgpJqoObTY7svFrktN8GcBxCnsFdJDnA01i2GQT1nxSLc1mdQ4y6aTfCco\#b22}{Moinse and L’Hostis, 2024}).},
  file = {/home/lhostis/Zotero/storage/XHYP6U9K/S096669232600270X.html}
}

